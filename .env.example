# Copy to .env and adjust. Never commit .env or real credentials.

# --- Local Postgres container (localdev profile only) -----------------------
# Ignored entirely once DATABASE_URL points at the real application database.
POSTGRES_DB=mhn_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432

# Host ports. Override any that collide with other stacks on your machine.
API_HOST_PORT=8000

# Path to the Spring base schema, imported on first boot of an empty volume.
SPRING_SCHEMA_PATH=../mhn-spring/migrations/index.sql

# --- Database ---------------------------------------------------------------
# The ONLY thing that changes when swapping to the real application database.
# From the host (DBeaver, alembic, tests):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mhn_ai
# From inside a compose container, the host is the service name instead: db:5432

# --- AWS --------------------------------------------------------------------
# Real AWS. Leave AWS_ENDPOINT_URL empty so boto3 resolves real endpoints.
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
# Credentials for the default boto3 chain. Prefer an IAM user with least privilege:
# s3:GetObject + s3:HeadObject on the source bucket, and SQS ReceiveMessage /
# DeleteMessage / SendMessage / ChangeMessageVisibility on the queues. Never commit
# real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only when using temporary credentials
S3_BUCKET=
# Full queue URLs from the SQS console. Never assembled from account id/region in code.
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/report-processing
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/report-processing-dlq
SQS_MAX_RECEIVE_COUNT=5

# --- Worker -----------------------------------------------------------------
WORKER_MAX_CONCURRENCY=4
MAX_ATTEMPTS=3
STALE_ITEM_TIMEOUT_SECONDS=900

# --- File validation --------------------------------------------------------
MAX_FILE_BYTES=52428800
ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
# Pages of a PDF sent to the classifier (type is evident early; extraction reads all).
# 0 disables trimming and sends the whole document.
CLASSIFY_MAX_PAGES=2

# --- AI provider ------------------------------------------------------------
AI_PROVIDER=anthropic
# Default model for classification + extraction (used when a stage has no override below).
AI_MODEL=
# Insight-generation model; empty falls back to AI_MODEL.
AI_MODEL_INSIGHTS=
AI_MAX_TOKENS=4096
ANTHROPIC_API_KEY=

# Per-stage provider overrides. Empty = the stage runs on AI_PROVIDER, which is the
# single-provider default. Only "gemini" is recognised; it needs GOOGLE_API_KEY, and every
# model set here needs a price entry in app/integrations/ai/pricing.py or its cost logs as
# zero. Classification picks one label from two pages and extraction transcribes a table —
# measured identical out-of-range flags at half the cost (docs/ai-provider-comparison.md).
# Insight generation has no override by design: it is the patient-facing reasoning stage
# and stays on Claude.
CLASSIFICATION_PROVIDER=gemini
AI_MODEL_CLASSIFICATION=gemini-3.1-flash-lite
EXTRACTION_PROVIDER=gemini
AI_MODEL_EXTRACTION=gemini-3.1-flash-lite
GOOGLE_API_KEY=

# Override the report's reference range with the R&D-approved ideal range for the patient's
# age bracket, from the Spring-owned THP tables (traditional_health_parameters /
# thp_age_range / thp_alternate_units). Keep FALSE until those tables exist in the target
# database and carry approved rows — an empty master sends every test to the fallback
# worklist, and a missing table breaks the lookup outright.
IDEAL_RANGES_ENABLED=false

# --- OCR (section extraction) -----------------------------------------------
# Path to the Tesseract BINARY, which pytesseract only binds to. Leave empty when it is
# on PATH — which it is in the Docker image, and usually is not on Windows. Read at
# import by app/services/ocr.py rather than through Settings, because pytesseract holds
# it as a module global that must be set before the first OCR call.
# Without a working binary, digital PDFs still work (a text layer needs no binary) and
# scanned ones fail with text_extraction_failed.
TESSERACT_CMD=

# --- Service ----------------------------------------------------------------
# Shared secret proving the caller is the Spring backend. It authenticates a
# *service*, not a user: this service performs no user-level authorization.
# The app refuses to start if this is unset or shorter than 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MHN_SERVICE_TOKEN=
LOG_LEVEL=INFO
